# Configure these for a real OIDC provider before running outside local tests.
UJEXA_ENV=development
UJEXA_DATABASE_URL=sqlite:///./ujexa-dev.db
UJEXA_OIDC_ISSUER=https://YOUR-IDENTITY-PROVIDER/
UJEXA_OIDC_AUDIENCE=ujexa-health-api
UJEXA_OIDC_JWKS_URL=https://YOUR-IDENTITY-PROVIDER/.well-known/jwks.json
UJEXA_OIDC_ALGORITHMS=RS256,ES256
UJEXA_REQUIRE_MFA=true
UJEXA_MFA_ACR=
UJEXA_ACCESS_TOKEN_LEEWAY_SECONDS=30
