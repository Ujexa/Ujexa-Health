{
  "openapi": "3.1.0",
  "info": {
    "title": "Ujexa Health API",
    "description": "Identity and device-trust foundation. Health records and cryptographic key recovery are deliberately out of scope.",
    "version": "0.2.0"
  },
  "paths": {
    "/v1/identity/device-challenges": {
      "post": {
        "tags": [
          "identity & device trust"
        ],
        "summary": "Create Device Challenge",
        "operationId": "create_device_challenge_v1_identity_device_challenges_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChallengeResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/identity/devices": {
      "get": {
        "tags": [
          "identity & device trust"
        ],
        "summary": "List Devices",
        "operationId": "list_devices_v1_identity_devices_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DeviceResponse"
                  },
                  "type": "array",
                  "title": "Response List Devices V1 Identity Devices Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "identity & device trust"
        ],
        "summary": "Enroll Device",
        "operationId": "enroll_device_v1_identity_devices_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceEnrollRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/identity/devices/{device_id}": {
      "delete": {
        "tags": [
          "identity & device trust"
        ],
        "summary": "Revoke Device",
        "operationId": "revoke_device_v1_identity_devices__device_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Device Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevokeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/identity/sessions/revoke-current": {
      "post": {
        "tags": [
          "identity & device trust"
        ],
        "summary": "Revoke Current Session",
        "operationId": "revoke_current_session_v1_identity_sessions_revoke_current_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevokeResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/identity/me": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Identity Profile",
        "operationId": "identity_profile_v1_identity_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ChallengeResponse": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "title": "Challenge Id"
          },
          "nonce": {
            "type": "string",
            "title": "Nonce"
          },
          "expires_in_seconds": {
            "type": "integer",
            "title": "Expires In Seconds"
          }
        },
        "type": "object",
        "required": [
          "challenge_id",
          "nonce",
          "expires_in_seconds"
        ],
        "title": "ChallengeResponse"
      },
      "DeviceEnrollRequest": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "title": "Challenge Id"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "public_key": {
            "type": "string",
            "maxLength": 64,
            "minLength": 40,
            "title": "Public Key",
            "description": "Base64url-encoded raw 32-byte Ed25519 public key"
          },
          "signature": {
            "type": "string",
            "maxLength": 128,
            "minLength": 80,
            "title": "Signature",
            "description": "Base64url signature over the documented enrollment message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge_id",
          "name",
          "public_key",
          "signature"
        ],
        "title": "DeviceEnrollRequest"
      },
      "DeviceResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "last_seen_at": {
            "type": "string",
            "title": "Last Seen At"
          },
          "is_current_device": {
            "type": "boolean",
            "title": "Is Current Device",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "created_at",
          "last_seen_at"
        ],
        "title": "DeviceResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RevokeResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "revoked_id": {
            "type": "string",
            "title": "Revoked Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "revoked_id"
        ],
        "title": "RevokeResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
