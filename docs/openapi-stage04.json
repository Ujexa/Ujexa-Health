  "components": {
    "schemas": {
      "ChallengeResponse": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "title": "Challenge Id"
          },
          "nonce": {
            "type": "string",
            "title": "Nonce"
          },
          "expires_in_seconds": {
            "type": "integer",
            "title": "Expires In Seconds"
          }
        },
        "type": "object",
        "required": [
          "challenge_id",
          "nonce",
          "expires_in_seconds"
        ],
        "title": "ChallengeResponse"
      },
      "DeviceEnrollRequest": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "title": "Challenge Id"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "public_key": {
            "type": "string",
            "maxLength": 64,
            "minLength": 40,
            "title": "Public Key",
            "description": "Base64url-encoded raw 32-byte Ed25519 public key"
          },
          "encryption_public_key": {
            "type": "string",
            "maxLength": 64,
            "minLength": 40,
            "title": "Encryption Public Key",
            "description": "Base64url-encoded raw 32-byte X25519 key-agreement public key"
          },
          "signature": {
            "type": "string",
            "maxLength": 128,
            "minLength": 80,
            "title": "Signature",
            "description": "Base64url signature over the documented enrollment message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge_id",
          "name",
          "public_key",
          "encryption_public_key",
          "signature"
        ],
        "title": "DeviceEnrollRequest"
      },
      "DeviceResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "last_seen_at": {
            "type": "string",
            "title": "Last Seen At"
          },
          "is_current_device": {
            "type": "boolean",
            "title": "Is Current Device",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "created_at",
          "last_seen_at"
        ],
        "title": "DeviceResponse"
      },
      "EncryptedHealthRecordInput": {
        "properties": {
          "record_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "title": "Record Id"
          },
          "version": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Version"
          },
          "algorithm": {
            "type": "string",
            "pattern": "^AES-256-GCM$",
            "title": "Algorithm"
          },
          "nonce": {
            "type": "string",
            "maxLength": 24,
            "minLength": 16,
            "title": "Nonce"
          },
          "ciphertext": {
            "type": "string",
            "maxLength": 12000000,
            "minLength": 22,
            "title": "Ciphertext"
          },
          "ciphertext_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Ciphertext Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "record_id",
          "version",
          "algorithm",
          "nonce",
          "ciphertext",
          "ciphertext_sha256"
        ],
        "title": "EncryptedHealthRecordInput"
      },
      "EncryptedObjectInput": {
        "properties": {
          "object_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "title": "Object Id"
          },
          "version": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Version"
          },
          "algorithm": {
            "type": "string",
            "pattern": "^AES-256-GCM$",
            "title": "Algorithm"
          },
          "nonce": {
            "type": "string",
            "maxLength": 24,
            "minLength": 16,
            "title": "Nonce"
          },
          "ciphertext": {
            "type": "string",
            "maxLength": 12000000,
            "minLength": 22,
            "title": "Ciphertext"
          },
          "ciphertext_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Ciphertext Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "object_id",
          "version",
          "algorithm",
          "nonce",
          "ciphertext",
          "ciphertext_sha256"
        ],
        "title": "EncryptedObjectInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KeyEnvelopeInput": {
        "properties": {
          "envelope_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "title": "Envelope Id"
          },
          "recipient_type": {
            "type": "string",
            "pattern": "^(recovery|device)$",
            "title": "Recipient Type"
          },
          "recipient_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 36
              },
              {
                "type": "null"
              }
            ],
            "title": "Recipient Id"
          },
          "algorithm": {
            "type": "string",
            "maxLength": 64,
            "minLength": 10,
            "title": "Algorithm"
          },
          "envelope_json": {
            "additionalProperties": true,
            "type": "object",
            "title": "Envelope Json"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "envelope_id",
          "recipient_type",
          "algorithm",
          "envelope_json"
        ],
        "title": "KeyEnvelopeInput"
      },
      "RevokeResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
